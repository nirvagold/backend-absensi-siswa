{
  "version": 2,
  "functions": {
    "src/index.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "src/index.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/alpha",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/sync",
      "schedule": "0 2 * * *"
    }
  ]
}