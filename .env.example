# Environment Variables
# Copy ke .env.local untuk development lokal
DATABASE_URL="postgresql://user:password@localhost:5432/absensi_db"
JWT_SECRET="ganti-dengan-string-acak-yang-panjang"
JWT_EXPIRES_IN="2h"
PORT=3000

# Dapodik
DAPODIK_NGROK_URL=""
DAPODIK_TOKEN=""
DAPODIK_NPSN=""

# WhatsApp — dikirim lewat Fonnte (bukan Meta Cloud API)
# Kalau kosong, pengiriman WA balas { status: "gagal" } dan tetap dicatat di notifikasi_log
FONNTE_TOKEN=""

# ------------------------------------------------------------------
# Aturan absensi
# ------------------------------------------------------------------

# 1) WA otomatis
#   Nilai AWAL saja -- admin bisa ganti sendiri dari UI lewat
#   PUT /api/notifikasi/setting (tersimpan di tabel `pengaturan`).
#   Kalau barisnya belum pernah diisi, nilai ini yang dipakai.
#     "true"  = otomatis (default)   -> kirim utk Hadir / Terlambat
#     "false" = tidak otomatis       -> admin kirim manual /api/notifikasi/kirim/:absensi_id
WA_KIRIM_OTOMATIS="true"

# ------------------------------------------------------------------
# 2) Pembagian jam absensi (HH:MM, WIB)
# ------------------------------------------------------------------
#   06:00 - 07:00  scan masuk -> "Hadir"
#   07:00 - 08:00  scan masuk -> "Terlambat"
#   08:00 dst.     jam absen TUTUP; siswa yang belum absen -> "Tidak Hadir" + "Alfa"
#
#   ABSEN_JAM_MULAI   : sebelum jam ini scan ditolak (400 OUTSIDE_ABSEN_HOURS)
#   ABSEN_BATAS_MASUK : batas Hadir vs Terlambat
#   ABSEN_JAM_SELESAI : setelah (dan tepat) jam ini scan ditolak
#   ABSEN_BATAS_ALFA  : jam alfa otomatis jalan
ABSEN_JAM_MULAI="06:00"
ABSEN_BATAS_MASUK="07:00"
ABSEN_JAM_SELESAI="08:00"
ABSEN_BATAS_ALFA="08:00"

# 3) Scheduler alfa otomatis
#   CRON_SECRET   : secret yang diperiksa endpoint /api/cron/alfa. Vercel Cron mengirimnya
#                   sebagai header `Authorization: Bearer <CRON_SECRET>`; endpoint juga
#                   menerima header `x-cron-secret`. Harus diset. Bebas, atau crypto.randomBytes(24).
#   JADWAL_JOBS   : pada Railway/process lama (bukan Vercel serverless), hidupkan scheduler
#                   dalam-proses dengan TIDAK men-set ini ke "false".
#   Catatan: jadwal Vercel Cron ada di vercel.json (01:00 UTC = 08:00 WIB).
CRON_SECRET=""
JADWAL_JOBS="false"